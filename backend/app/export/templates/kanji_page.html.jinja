<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  @font-face {
    font-family: "Satoshi";
    src: url("{{ fonts.satoshi_regular }}") format("woff2");
    font-weight: 400; font-style: normal;
  }
  @font-face {
    font-family: "Satoshi";
    src: url("{{ fonts.satoshi_medium }}") format("woff2");
    font-weight: 500; font-style: normal;
  }
  @font-face {
    font-family: "Satoshi";
    src: url("{{ fonts.satoshi_bold }}") format("woff2");
    font-weight: 700; font-style: normal;
  }
  @font-face {
    font-family: "Klee One";
    src: url("{{ fonts.klee_one }}") format("woff2");
    font-weight: 400; font-style: normal;
  }

  @page { size: A4 landscape; margin: 12mm; }
  body { font-family: "Satoshi", "Noto Sans JP", "Yu Gothic", sans-serif; margin: 0; }
  .kanji-page { break-after: page; padding: 4mm; }
  .kanji-page:last-child { break-after: auto; }

  .header { display: flex; align-items: flex-start; gap: 10mm; margin-bottom: 8mm; }
  .kanji-box {
    width: 42mm; height: 42mm; flex: none;
    background: #dbeeff; border-radius: 8mm;
    display: flex; align-items: center; justify-content: center;
    font-size: 30mm; line-height: 1;
  }
  .kanji-box-handwritten {
    width: 42mm; height: 42mm; flex: none;
    background: #fff; border: 0.4mm dashed #bbb; border-radius: 8mm;
    display: flex; align-items: center; justify-content: center;
    font-family: "Klee One", "Noto Sans JP", sans-serif;
    font-size: 30mm; line-height: 1; color: #333;
  }
  .meta { flex: 1; }
  .meanings { font-size: 6mm; margin-bottom: 3.5mm; }
  .meanings strong { font-weight: 700; }
  .readings { font-size: 5.5mm; display: flex; flex-direction: column; gap: 2mm; }
  .readings .kun { color: #1a56db; }
  .readings .on { color: #15803d; }

  .stroke-order { display: flex; flex-wrap: wrap; gap: 2.5mm; margin-bottom: 7mm; }
  .stroke-box {
    width: 20mm; height: 20mm; border: 0.3mm solid #ccc; border-radius: 1mm;
    position: relative; flex: none;
  }
  .stroke-box svg { width: 100%; height: 100%; }
  .step-number {
    position: absolute; bottom: 0.3mm; right: 0.6mm;
    font-size: 2.6mm; color: #999;
  }

  .words-label { font-size: 5.5mm; font-weight: 700; margin-bottom: 2.5mm; }
  .word-line { font-size: 5mm; margin-bottom: 2mm; }
</style>
</head>
<body>
{% for page in pages %}
<div class="kanji-page">
  <div class="header">
    <div class="kanji-box">{{ page.kanji }}</div>
    <div class="kanji-box-handwritten">{{ page.kanji }}</div>
    <div class="meta">
      <div class="meanings">意味： <strong>{{ page.meanings }}</strong></div>
      <div class="readings">
        <span class="kun">訓： {{ page.kun_yomi }}</span>
        <span class="on">音： {{ page.on_yomi }}</span>
      </div>
    </div>
  </div>

  <div class="stroke-order">
    {% for step in page.stroke_steps %}
    <div class="stroke-box">
      <svg viewBox="0 0 109 109">
        {% for path_d in step %}
        <path d="{{ path_d }}" fill="none"
              stroke="{% if loop.last %}#111{% else %}#ccc{% endif %}"
              stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        {% endfor %}
      </svg>
      <span class="step-number">{{ loop.index }}</span>
    </div>
    {% endfor %}
  </div>

  <div class="words">
    <div class="words-label">言葉：</div>
    {% for word in page.words %}
    <div class="word-line">{{ word.kanji_form }}（{{ word.hiragana_form }}） {{ word.meaning }}</div>
    {% endfor %}
  </div>
</div>
{% endfor %}
</body>
</html>
